generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  OFFICE_MANAGER
  PROJECT_MANAGER
  FIELD_WORKER
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING_SCHEDULED
  QUOTE_SENT
  NEGOTIATION
  CONVERTED
  LOST
}

enum LeadSource {
  REFERRAL
  WEBSITE
  PHONE
  SOCIAL_MEDIA
  WALK_IN
  GOOGLE_ADS
  FACEBOOK
  WORD_OF_MOUTH
  COLD_CALL
  B2B
  EXHIBITION
  WEBSITE_ORGANIC
  OTHER
}

enum LeadUrgency {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MemberRole {
  MANAGER
  ENGINEER
  FOREMAN
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum QCResult {
  PASS
  FAIL
  PENDING
}

enum NCRSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NCRStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum RiskStatus {
  OPEN
  MITIGATED
  CLOSED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CHECK
  CASH
  CREDIT_CARD
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
}

enum SupplierType {
  SUPPLIER
  SUBCONTRACTOR
}

enum ExpenseCategory {
  MATERIALS
  FUEL
  TOOLS
  MEALS
  TRANSPORT
  OTHER
}

enum PrefabStatus {
  PLANNED
  IN_PRODUCTION
  QUALITY_CHECK
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  INSTALLED
}

enum CommunicationType {
  CALL
  MEETING
  EMAIL
  NOTE
}

enum TaskType {
  GENERAL
  CALL
  MEETING
  EMAIL
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(FIELD_WORKER)
  phone            String?
  avatarUrl        String?
  active           Boolean  @default(true)
  dashboardLayout  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads        Lead[]          @relation("LeadAssignee")
  managedProjects      Project[]       @relation("ProjectManager")
  projectMembers       ProjectMember[]
  uploadedFiles        ProjectFile[]
  assignedTasks        Task[]          @relation("TaskAssignee")
  supervisedLogs       DailyLog[]      @relation("LogSupervisor")
  approvedTimeEntries  TimeEntry[]     @relation("TimeEntryApprover")
  approvedExpenses     Expense[]       @relation("ExpenseApprover")
  approvedChangeRequests ChangeRequest[] @relation("CRApprover")
  notifications        Notification[]
  activityLogs         ActivityLog[]
  communicationLogs    CommunicationLog[]
  sentInvitations      Invitation[]    @relation("SentInvitations")
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        UserRole  @default(FIELD_WORKER)
  token       String    @unique @default(cuid())
  invitedById String?
  invitedBy   User?     @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Lead {
  id              String      @id @default(cuid())
  name            String
  phone           String
  phone2          String?
  email           String?
  propertyAddress String?
  city            String?
  estimatedSize   Float?
  constructionTypes String[]
  source          LeadSource  @default(OTHER)
  status          LeadStatus  @default(NEW)
  urgency         LeadUrgency @default(MEDIUM)
  budget          Float?
  notes           String?
  assignedToId         String?
  assignedTo           User?     @relation("LeadAssignee", fields: [assignedToId], references: [id])
  assignedEmployeeId   String?
  assignedEmployee     Employee? @relation("LeadEmployee", fields: [assignedEmployeeId], references: [id])
  convertedAt     DateTime?
  convertedToId   String?
  client          Client?     @relation("LeadToClient", fields: [convertedToId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  quotes         Quote[]
  communications CommunicationLog[]
  files          ProjectFile[]
  tasks          Task[]
}

model Client {
  id            String   @id @default(cuid())
  name          String
  contactName   String?
  email         String?
  phone         String?
  phone2        String?
  address       String?
  companyNumber String?
  notes         String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leads          Lead[]    @relation("LeadToClient")
  projects       Project[]
  quotes         Quote[]
  invoices       Invoice[]
  communications CommunicationLog[]
  files          ProjectFile[]
  tasks          Task[]
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  address         String?
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status          ProjectStatus @default(PLANNING)
  startDate       DateTime?
  endDate         DateTime?
  contractValue   Float         @default(0)
  progressPercent Float         @default(0)
  latitude        Float?
  longitude       Float?
  managerId       String?
  manager         User?         @relation("ProjectManager", fields: [managerId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  settings       ProjectSettings?
  members        ProjectMember[]
  files          ProjectFile[]
  milestones     Milestone[]
  tasks          Task[]
  workPackages   WorkPackage[]
  qualityChecks  QualityCheck[]
  ncrs           NCR[]
  risks          Risk[]
  changeRequests ChangeRequest[]
  dailyLogs      DailyLog[]
  timeEntries    TimeEntry[]
  expenses       Expense[]
  equipmentLogs  EquipmentLog[]
  contracts      Contract[]
  quotes         Quote[]
  invoices       Invoice[]
  prefabElements PrefabElement[]
}

model ProjectSettings {
  id                 String  @id @default(cuid())
  projectId          String  @unique
  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  qcEnabled          Boolean @default(true)
  risksEnabled       Boolean @default(true)
  crEnabled          Boolean @default(true)
  milestonesEnabled  Boolean @default(true)
  wbsEnabled         Boolean @default(true)
  procurementEnabled Boolean @default(true)
  ganttEnabled       Boolean @default(true)
}

model ProjectMember {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  role      MemberRole @default(VIEWER)
  createdAt DateTime   @default(now())

  @@unique([projectId, userId])
}

enum FileCategory {
  PLANS
  CONTRACTS
  PERMITS
  PHOTOS
  OTHER
}

model ProjectFile {
  id           String       @id @default(cuid())
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  url          String
  fileType     String?
  sizeBytes    Int?
  category     FileCategory @default(OTHER)
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())
}

// ─── Planning ────────────────────────────────────────────────────────────────

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime
  weight      Float     @default(1)
  completed   Boolean   @default(false)
  completedAt DateTime?
  notes       String?
  order       Int       @default(0)

  tasks Task[]
}

model Task {
  id           String       @id @default(cuid())
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taskType     TaskType     @default(GENERAL)
  milestoneId  String?
  milestone    Milestone?   @relation(fields: [milestoneId], references: [id])
  assignedToId String?
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  name         String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  dependsOnId  String?
  dependsOn    Task?        @relation("TaskDependencies", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependentTasks Task[]     @relation("TaskDependencies")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  prefabElements PrefabElement[]
}

// ─── WBS & Catalog ───────────────────────────────────────────────────────────

model CatalogItem {
  id          String   @id @default(cuid())
  name        String
  sku         String?
  description String?
  unit        String
  unitCost    Float    @default(0)
  category    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bomItems   BOMItem[]
  quoteItems QuoteItem[]
}

model WorkPackage {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  plannedCost       Float     @default(0)
  actualCost        Float     @default(0)
  startDate         DateTime?
  endDate           DateTime?
  completionPercent Float     @default(0)
  order             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bomItems BOMItem[]
}

model BOMItem {
  id            String       @id @default(cuid())
  workPackageId String
  workPackage   WorkPackage  @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])
  name          String
  unit          String
  quantity      Float        @default(0)
  unitCost      Float        @default(0)
  totalCost     Float        @default(0)
}

// ─── Quality & Safety ────────────────────────────────────────────────────────

model QualityCheck {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  type      String
  result    QCResult @default(PENDING)
  inspector String?
  notes     String?
  photos    String?
  createdAt DateTime @default(now())
}

model NCR {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime    @default(now())
  description String
  severity    NCRSeverity @default(MEDIUM)
  status      NCRStatus   @default(OPEN)
  assignedTo  String?
  resolution  String?
  closedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Risk {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String
  probability Int        @default(3)
  impact      Int        @default(3)
  mitigation  String?
  status      RiskStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model ChangeRequest {
  id             String              @id @default(cuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy    String
  date           DateTime            @default(now())
  description    String
  status         ChangeRequestStatus @default(PENDING)
  costImpact     Float               @default(0)
  scheduleImpact Int                 @default(0)
  approvedById   String?
  approvedBy     User?               @relation("CRApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model DailyLog {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date              DateTime
  weatherConditions String?
  visitors          String?
  safetyIncidents   String?
  notes             String?
  supervisorId      String?
  supervisor        User?    @relation("LogSupervisor", fields: [supervisorId], references: [id])
  createdAt         DateTime @default(now())

  @@unique([projectId, date])
}

// ─── HR & Field ──────────────────────────────────────────────────────────────

model Employee {
  id         String    @id @default(cuid())
  name       String
  phone      String?
  idNumber   String?   @unique
  trade      String?
  hourlyRate Float     @default(0)
  startDate  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  timeEntries   TimeEntry[]
  expenses      Expense[]
  equipmentLogs EquipmentLog[]
  assignedLeads Lead[]         @relation("LeadEmployee")
}

model TimeEntry {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date         DateTime
  hours        Float
  hourlyRate   Float
  totalCost    Float
  description  String?
  approved     Boolean   @default(false)
  approvedById String?
  approvedBy   User?     @relation("TimeEntryApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model Expense {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?       @relation(fields: [employeeId], references: [id])
  date         DateTime
  amount       Float
  category     ExpenseCategory @default(OTHER)
  description  String?
  receiptUrl   String?
  approved     Boolean         @default(false)
  approvedById String?
  approvedBy   User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime        @default(now())
}

model Equipment {
  id               String          @id @default(cuid())
  name             String
  code             String?         @unique
  status           EquipmentStatus @default(AVAILABLE)
  currentProjectId String?
  value            Float?
  purchaseDate     DateTime?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  logs EquipmentLog[]
}

model EquipmentLog {
  id           String     @id @default(cuid())
  equipmentId  String
  equipment    Equipment  @relation(fields: [equipmentId], references: [id])
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  checkOutDate DateTime
  checkInDate  DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
}

// ─── Quotes & Invoices ───────────────────────────────────────────────────────

model Quote {
  id          String      @id @default(cuid())
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?       @relation(fields: [leadId], references: [id])
  quoteNumber String?
  date        DateTime    @default(now())
  validUntil  DateTime?
  status      QuoteStatus @default(DRAFT)
  subtotal           Float       @default(0)
  contingencyPercent Float       @default(0)
  taxPercent         Float       @default(17)
  taxAmount          Float       @default(0)
  total              Float       @default(0)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  categories QuoteCategory[]
  items      QuoteItem[]
  invoices   Invoice[]
}

model QuoteCategory {
  id        String    @id @default(cuid())
  quoteId   String
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name      String
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  items QuoteItem[]
}

model QuoteItem {
  id            String         @id @default(cuid())
  quoteId       String
  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      QuoteCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  catalogItemId String?
  catalogItem   CatalogItem?   @relation(fields: [catalogItemId], references: [id])
  name          String
  unit          String
  dim1          Float?
  dim2          Float?
  quantity      Float          @default(1)
  unitPrice     Float          @default(0)
  costPrice     Float          @default(0)
  linePrice     Float          @default(0)
  profitPercent Float          @default(0)
  order         Int            @default(0)
}

model Invoice {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quoteId       String?
  quote         Quote?        @relation(fields: [quoteId], references: [id])
  invoiceNumber String        @unique
  date          DateTime      @default(now())
  dueDate       DateTime?
  status        InvoiceStatus @default(DRAFT)
  amount        Float
  taxPercent    Float         @default(17)
  taxAmount     Float         @default(0)
  total         Float
  paidAmount    Float         @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments Payment[]
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Float
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
}

// ─── Procurement ─────────────────────────────────────────────────────────────

model Supplier {
  id          String       @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  type        SupplierType @default(SUPPLIER)
  rating      Int?
  bankDetails String?
  notes       String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  contracts Contract[]
}

model Contract {
  id                String         @id @default(cuid())
  projectId         String
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier       @relation(fields: [supplierId], references: [id])
  description       String?
  value             Float          @default(0)
  startDate         DateTime?
  endDate           DateTime?
  status            ContractStatus @default(DRAFT)
  retentionPercent  Float          @default(0)
  retentionReleased Boolean        @default(false)
  paidAmount        Float          @default(0)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  payments SupplierPayment[]
}

model SupplierPayment {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     Float
  reference  String?
  notes      String?
  createdAt  DateTime @default(now())
}

// ─── Prefab / Production Tracking ───────────────────────────────────────────

model PrefabElement {
  id                  String       @id @default(cuid())
  projectId           String
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId              String?
  task                Task?        @relation(fields: [taskId], references: [id])
  name                String
  elementType         String
  status              PrefabStatus @default(PLANNED)
  productionStartDate DateTime?
  targetDeliveryDate  DateTime?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

// ─── System ──────────────────────────────────────────────────────────────────

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String?
  read        Boolean  @default(false)
  relatedId   String?
  relatedType String?
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}

model CommunicationLog {
  id        String            @id @default(cuid())
  type      CommunicationType @default(NOTE)
  content   String
  leadId    String?
  lead      Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User              @relation(fields: [authorId], references: [id])
  createdAt DateTime          @default(now())
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
